---
import Layout from '../layouts/Layout.astro';

const plans = [
  {
    key: 'patchable',
    name: 'Patchable',
    tagline: 'Patch management + Slack alerts',
    monthly: 29,
    annual: 23,
    deviceBase: 25,
    overageMonthly: 2.50,
    color: 'amber',
    features: [
      'Up to 25 devices included',
      'Patchable agent (patch management)',
      'Slack & Teams notifications',
      'CVE vulnerability tracking',
      'Automation engine',
      'API access',
    ],
    cta: 'Get started',
  },
  {
    key: 'managed',
    name: 'Managed',
    tagline: 'Full Apple MDM',
    monthly: 59,
    annual: 47,
    deviceBase: 25,
    overageMonthly: 4.50,
    color: 'blue',
    highlight: true,
    features: [
      'Everything in Patchable',
      'Full Apple MDM (DDM-native)',
      'SCEP device certificates',
      'Apple Business Manager',
      'FileVault + key escrow',
      'Profiles & declarations',
      'Script execution',
      'SCIM 2.0 provisioning',
    ],
    cta: 'Get started',
  },
  {
    key: 'msp_patch',
    name: 'MSP Patch',
    tagline: 'Volume Patchable for MSPs',
    monthly: null,
    annual: null,
    graduated: [
      { range: '1–250 devices',   price: 6 },
      { range: '251–1,000 devices', price: 5 },
      { range: '1,001+ devices', price: 4 },
    ],
    color: 'green',
    features: [
      'Everything in Patchable',
      'Multi-org partner dashboard',
      'Consolidated billing',
      'Volume device pricing',
      'Per-client org isolation',
      'Dedicated support',
    ],
    cta: 'Contact us',
    ctaHref: 'mailto:hello@mngd.app',
  },
  {
    key: 'msp_managed',
    name: 'MSP Managed',
    tagline: 'Volume MDM for MSPs',
    monthly: null,
    annual: null,
    graduated: [
      { range: '1–250 devices',   price: 9 },
      { range: '251–1,000 devices', price: 7.50 },
      { range: '1,001+ devices', price: 6 },
    ],
    color: 'violet',
    features: [
      'Everything in Managed',
      'Multi-org partner dashboard',
      'Consolidated billing',
      'Volume device pricing',
      'Per-client org isolation',
      'Dedicated support',
    ],
    cta: 'Contact us',
    ctaHref: 'mailto:hello@mngd.app',
  },
];

const colorMap: Record<string, { border: string; badge: string; check: string }> = {
  amber:  { border: 'border-amber-500/30',  badge: 'bg-amber-500/10 text-amber-400',  check: 'text-amber-400' },
  blue:   { border: 'border-blue/40',        badge: 'bg-blue/10 text-blue',            check: 'text-blue' },
  green:  { border: 'border-green-500/30',  badge: 'bg-green-500/10 text-green-400',  check: 'text-green-400' },
  violet: { border: 'border-violet-500/30', badge: 'bg-violet-500/10 text-violet-400', check: 'text-violet-400' },
};
---

<Layout
  title="Pricing — mngd"
  description="Simple, honest pricing for Apple MDM. Four plans from patch management to full MSP MDM."
>

  <section class="section pt-28">
    <div class="container">

      <div class="text-center mb-6">
        <div class="label mb-4">Pricing</div>
        <h1 class="text-4xl md:text-5xl font-semibold text-white tracking-tight mb-4">
          Simple, honest pricing.
        </h1>
        <p class="text-white/50 max-w-lg mx-auto">
          No per-seat gotchas on the lower tiers. MSP plans scale linearly with your fleet.
          All plans include a free tier for up to 5 devices.
        </p>
      </div>

      <!-- Toggle (visual only — JS handles it) -->
      <div class="flex items-center justify-center gap-3 mb-12" id="billing-toggle">
        <button
          id="btn-monthly"
          class="text-sm px-4 py-1.5 rounded-full font-medium transition-colors bg-white/10 text-white"
          onclick="setBilling('monthly')"
        >
          Monthly
        </button>
        <button
          id="btn-annual"
          class="text-sm px-4 py-1.5 rounded-full font-medium transition-colors text-white/50 hover:text-white"
          onclick="setBilling('annual')"
        >
          Annual
          <span class="ml-1.5 text-[11px] px-1.5 py-0.5 rounded bg-green-500/20 text-green-400 font-semibold">–20%</span>
        </button>
      </div>

      <!-- Plan grid -->
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4 items-start">
        {plans.map((plan) => {
          const c = colorMap[plan.color];
          return (
            <div class={`card p-6 flex flex-col gap-5 ${plan.highlight ? `border ${c.border} ring-1 ring-inset ring-blue/20` : ''}`}>

              <!-- Header -->
              <div>
                <div class={`inline-flex px-2 py-0.5 rounded text-[11px] font-semibold mb-3 ${c.badge}`}>
                  {plan.name}
                </div>
                <p class="text-xs text-white/40">{plan.tagline}</p>
              </div>

              <!-- Price -->
              <div>
                {plan.graduated ? (
                  <div class="space-y-1.5">
                    {plan.graduated.map(g => (
                      <div class="flex items-baseline justify-between">
                        <span class="text-xs text-white/40">{g.range}</span>
                        <span class="text-sm font-semibold text-white">${g.price}<span class="text-xs font-normal text-white/40">/dev</span></span>
                      </div>
                    ))}
                    <p class="text-[11px] text-white/30 pt-1">Per device per month</p>
                  </div>
                ) : (
                  <>
                    <div class="flex items-end gap-1">
                      <span class="monthly-price text-4xl font-semibold text-white">${plan.monthly}</span>
                      <span class="annual-price text-4xl font-semibold text-white hidden">${plan.annual}</span>
                      <span class="text-sm text-white/40 mb-1">/mo</span>
                    </div>
                    <p class="text-xs text-white/35 mt-1">
                      Includes {plan.deviceBase} devices ·
                      <span class="monthly-overage">${plan.overageMonthly}</span>
                      <span class="annual-overage hidden">${plan.overageMonthly}</span>
                      /device above
                    </p>
                  </>
                )}
              </div>

              <!-- CTA -->
              <a
                href={plan.ctaHref ?? 'https://app.mngd.app/register'}
                class={`text-center text-sm font-medium py-2 rounded-lg transition-colors ${
                  plan.highlight
                    ? 'bg-blue hover:bg-blue-hover text-white'
                    : 'border border-white/10 hover:border-white/20 text-white/70 hover:text-white'
                }`}
              >
                {plan.cta}
              </a>

              <!-- Features -->
              <ul class="space-y-2.5">
                {plan.features.map(f => (
                  <li class="flex items-start gap-2 text-sm text-white/55">
                    <svg class={`w-4 h-4 mt-0.5 shrink-0 ${c.check}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                    {f}
                  </li>
                ))}
              </ul>

            </div>
          );
        })}
      </div>

      <!-- Free plan note -->
      <div class="mt-6 text-center">
        <p class="text-sm text-white/35">
          All plans include a <span class="text-white/60">free tier for up to 5 devices</span> — no credit card required.
        </p>
      </div>

      <!-- FAQ -->
      <div class="mt-24 max-w-2xl mx-auto">
        <h2 class="text-2xl font-semibold text-white tracking-tight mb-8 text-center">Common questions</h2>
        <div class="space-y-4">
          {[
            {
              q: 'What counts as a device?',
              a: 'Any Mac, iPhone, iPad, or AppleTV enrolled in mngd. Devices are counted per org. Deleted or unenrolled devices stop counting immediately.',
            },
            {
              q: 'Can I switch plans?',
              a: 'Yes, any time. Upgrading takes effect immediately and is prorated. Downgrading takes effect at the end of the current billing period.',
            },
            {
              q: 'Do MSP plans require a minimum commitment?',
              a: 'No minimum. MSP plans are billed monthly based on actual device count across all your client orgs. Scale up or down freely.',
            },
            {
              q: 'What happens to existing Patchable customers?',
              a: 'If you\'re running Patchable today, your agent is already an mngd agent. Upgrading to a Managed plan adds full MDM — no re-enrollment, no migration.',
            },
            {
              q: 'Is there an annual discount?',
              a: 'Yes — annual plans on Patchable and Managed are 20% less than paying monthly. MSP plans are currently monthly-only.',
            },
          ].map(faq => (
            <details class="card p-5 group">
              <summary class="text-[15px] font-medium text-white cursor-pointer list-none flex items-center justify-between gap-4">
                {faq.q}
                <svg class="w-4 h-4 text-white/30 shrink-0 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </summary>
              <p class="mt-3 text-sm text-white/50 leading-relaxed">{faq.a}</p>
            </details>
          ))}
        </div>
      </div>

    </div>
  </section>

</Layout>

<script>
  function setBilling(mode: 'monthly' | 'annual') {
    const isAnnual = mode === 'annual';

    document.querySelectorAll('.monthly-price').forEach(el => {
      (el as HTMLElement).classList.toggle('hidden', isAnnual);
    });
    document.querySelectorAll('.annual-price').forEach(el => {
      (el as HTMLElement).classList.toggle('hidden', !isAnnual);
    });
    document.querySelectorAll('.monthly-overage').forEach(el => {
      (el as HTMLElement).classList.toggle('hidden', isAnnual);
    });
    document.querySelectorAll('.annual-overage').forEach(el => {
      (el as HTMLElement).classList.toggle('hidden', !isAnnual);
    });

    const btnMonthly = document.getElementById('btn-monthly')!;
    const btnAnnual  = document.getElementById('btn-annual')!;

    btnMonthly.classList.toggle('bg-white/10', !isAnnual);
    btnMonthly.classList.toggle('text-white',  !isAnnual);
    btnMonthly.classList.toggle('text-white/50', isAnnual);

    btnAnnual.classList.toggle('bg-white/10', isAnnual);
    btnAnnual.classList.toggle('text-white',  isAnnual);
    btnAnnual.classList.toggle('text-white/50', !isAnnual);
  }

  // Expose globally for onclick attributes
  (window as any).setBilling = setBilling;
</script>
