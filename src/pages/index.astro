---
import Layout from '../layouts/Layout.astro';
import CircuitHero from '../components/CircuitHero.astro';
---

<Layout
  title="mngd — Apple MDM for the DDM era"
  description="Modern Apple MDM built on Declarative Device Management. Launch pricing: $6/device/month, all features included. Free up to 25 devices with mngd patch."
>

<style>
  body { background: #000 !important; }

  .feature-grid {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 1px; background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 12px; overflow: hidden;
  }
  .feature-card {
    background: #0a0a0a; padding: 32px 28px;
    display: flex; flex-direction: column; gap: 12px;
  }
  .feature-icon {
    font-family: 'JetBrains Mono', monospace;
    font-size: 18px; color: #6B82F0; line-height: 1;
  }
  .feature-card h3 {
    font-size: 15px; font-weight: 600;
    letter-spacing: -0.01em; line-height: 1.3;
  }
  .feature-card p {
    font-size: 13px; color: rgba(255,255,255,0.45);
    line-height: 1.65;
  }

  .step-grid {
    display: grid; grid-template-columns: repeat(4, 1fr);
    gap: 1px; background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 12px; overflow: hidden;
  }
  .step-card {
    background: #0a0a0a; padding: 28px 24px;
  }
  .step-num {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px; color: rgba(255,255,255,0.2);
    margin-bottom: 16px;
  }
  .step-card h3 { font-size: 14px; font-weight: 600; letter-spacing: -0.01em; margin-bottom: 8px; }
  .step-card p  { font-size: 13px; color: rgba(255,255,255,0.45); line-height: 1.6; }

  .cta-band {
    background: #0a0a0a;
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 12px;
    padding: 64px 48px;
    text-align: center;
  }

  @media (max-width: 860px) {
    .feature-grid { grid-template-columns: 1fr; }
    .step-grid    { grid-template-columns: 1fr 1fr; }
    .cta-band     { padding: 40px 24px; }
  }
  @media (max-width: 540px) {
    .step-grid { grid-template-columns: 1fr; }
  }
</style>

<!-- ── Hero ──────────────────────────────────────────────────────────────── -->
<CircuitHero>
  <div style="max-width:1080px; margin:0 auto; padding:112px 32px 96px; text-align:center;">

    <div style="display:inline-flex; align-items:center; gap:8px; font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:0.06em; color:rgba(255,255,255,0.4); background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.08); padding:5px 14px; border-radius:99px; margin-bottom:32px; text-transform:uppercase;">
      Apple MDM · DDM-native
    </div>

    <h1 style="font-size:clamp(40px,6vw,72px); font-weight:600; letter-spacing:-0.04em; line-height:1.05; max-width:800px; margin:0 auto 24px;">
      Device management that<br>
      <span style="color:rgba(255,255,255,0.45);">stays out of your way.</span>
    </h1>

    <p style="font-size:18px; font-weight:300; color:rgba(255,255,255,0.5); max-width:520px; margin:0 auto 40px; line-height:1.65; letter-spacing:-0.01em;">
      mngd is a modern Apple MDM platform built on Declarative Device Management.
      Less polling. Less noise. Devices do what you declare.
    </p>

    <div style="display:flex; align-items:center; justify-content:center; gap:16px; flex-wrap:wrap; margin-bottom:20px;">
      <a href="https://app.mngd.app/register" class="mngd-btn-primary">
        Get started
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 11L11 3M6 3h5v5"/></svg>
      </a>
      <a href="/pricing" class="mngd-btn-secondary">See pricing</a>
    </div>
    <p style="font-size:13px; color:rgba(255,255,255,0.3);">
      Start free with <a href="/patch" style="color:rgba(255,255,255,0.5); text-decoration:underline; text-underline-offset:3px;">mngd patch</a> — no card required up to 25 devices.
    </p>

  </div>
</CircuitHero>

<hr class="divider" />

<!-- ── Social proof strip ─────────────────────────────────────────────────── -->
<div style="max-width:1080px; margin:0 auto; padding:28px 32px; display:flex; align-items:center; justify-content:center; gap:40px; flex-wrap:wrap;">
  {[
    'DDM-native from day one',
    'SCEP device certificates',
    'Apple Business Manager',
    'SCIM 2.0 provisioning',
    'Declarative profiles',
    'macOS · iOS · iPadOS',
  ].map(item => (
    <span style="font-size:12px; color:rgba(255,255,255,0.28); font-weight:500; letter-spacing:0.02em;">{item}</span>
  ))}
</div>

<hr class="divider" />

<!-- ── Features ───────────────────────────────────────────────────────────── -->
<section style="max-width:1080px; margin:0 auto; padding:80px 32px;">
  <div class="mono-label" style="margin-bottom:40px;">Platform</div>
  <h2 style="font-size:clamp(28px,4vw,42px); font-weight:600; letter-spacing:-0.03em; line-height:1.15; margin-bottom:48px; max-width:600px;">
    Built for where Apple MDM is going,<br>not where it's been.
  </h2>

  <div class="feature-grid">
    {[
      { icon: '◈', title: 'Declarative Device Management', body: 'DDM is Apple\'s replacement for the polling-based MDM protocol. mngd speaks DDM natively — declarations, not commands. Devices enforce their own configuration without waiting to be asked.' },
      { icon: '⬡', title: 'SCEP enrollment', body: 'Devices receive a signed identity certificate at enrollment via SCEP. mngd includes a built-in SCEP CA with a persistent cert/key so devices aren\'t orphaned by server restarts.' },
      { icon: '⊕', title: 'Apple Business Manager', body: 'Zero-touch deployment. Devices come out of the box enrolled, supervised, and configured — no imaging, no manual steps. ABM tokens are managed per-org.' },
      { icon: '⊞', title: 'MSP multi-tenancy', body: 'Manage multiple client orgs from a single MSP account. Consolidated billing, per-org feature flags, and a partner dashboard that gives you the full picture at a glance.' },
      { icon: '⊛', title: 'Smart groups & policies', body: 'Dynamic device groups built from live inventory data. Assign declarations and profiles to groups — mngd handles delivery, retry, and status tracking per device.' },
      { icon: '⊜', title: 'mngd patch', body: 'Start with patch management before committing to full MDM. The mngd patch agent becomes a full MDM agent — no re-enrollment, no migration, no rip and replace.' },
      { icon: '⊝', title: 'SCIM 2.0 provisioning', body: 'Sync users and groups from Okta, Azure AD, or any SCIM-compatible IdP. Users are provisioned and deprovisioned automatically. SSO enrollment supported.' },
      { icon: '⊡', title: 'FileVault & escrow', body: 'Enable FileVault via DDM declaration. Personal recovery keys are escrowed automatically at enrollment and rotated on schedule — no scripts required.' },
      { icon: '⊟', title: 'Automation engine', body: 'Event-driven automations triggered by device check-ins, CVE alerts, patch status, or custom webhooks. Route notifications to Slack, Teams, or any endpoint.' },
    ].map(f => (
      <div class="feature-card">
        <div class="feature-icon">{f.icon}</div>
        <h3>{f.title}</h3>
        <p>{f.body}</p>
      </div>
    ))}
  </div>
</section>

<hr class="divider" />

<!-- ── How it works ───────────────────────────────────────────────────────── -->
<section style="max-width:1080px; margin:0 auto; padding:80px 32px;">
  <div class="mono-label" style="margin-bottom:40px;">Enrollment</div>
  <h2 style="font-size:clamp(26px,3.5vw,38px); font-weight:600; letter-spacing:-0.03em; line-height:1.15; margin-bottom:48px;">
    From box to enrolled in under two minutes.
  </h2>

  <div class="step-grid">
    {[
      { step: '01', title: 'ABM assignment', body: 'Device ships from Apple already assigned to your org in Apple Business Manager.' },
      { step: '02', title: 'Zero-touch boot', body: 'Device boots, hits Apple\'s activation server, gets redirected to mngd enrollment.' },
      { step: '03', title: 'SCEP cert', body: 'Device generates a key pair, mngd issues a signed identity certificate via SCEP.' },
      { step: '04', title: 'DDM declarations', body: 'mngd pushes the device\'s full configuration as DDM declarations. Done.' },
    ].map(s => (
      <div class="step-card">
        <div class="step-num">{s.step}</div>
        <h3>{s.title}</h3>
        <p>{s.body}</p>
      </div>
    ))}
  </div>
</section>

<hr class="divider" />

<!-- ── Pricing teaser ─────────────────────────────────────────────────────── -->
<section style="max-width:1080px; margin:0 auto; padding:80px 32px;">
  <div style="display:grid; grid-template-columns:1fr 1fr; gap:48px; align-items:center;">
    <div>
      <div class="mono-label" style="margin-bottom:24px;">Pricing</div>
      <h2 style="font-size:clamp(26px,3.5vw,38px); font-weight:600; letter-spacing:-0.03em; line-height:1.15; margin-bottom:16px;">
        Simple, honest pricing.
      </h2>
      <p style="font-size:15px; color:rgba(255,255,255,0.5); line-height:1.7; margin-bottom:32px;">
        Launch pricing: $6/device/month. All features included, mngd patch bundled. Free up to 25 devices with mngd patch standalone.
      </p>
      <div style="display:flex; align-items:center; gap:12px; flex-wrap:wrap;">
        <a href="/early-access" class="mngd-btn-primary">Join the waitlist</a>
        <a href="/pricing" class="mngd-btn-secondary">See all pricing</a>
      </div>
    </div>
    <div style="display:flex; flex-direction:column; gap:1px; background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.06); border-radius:12px; overflow:hidden;">
      {[
        { product: 'mngd · Standard',    price: '$6/dev/mo',    sub: 'Annual · 10-device min',           color: '#2D3A9E' },
        { product: 'mngd · MSP',         price: '$4.50/dev/mo', sub: 'Annual · $150/mo account min',     color: '#7C3AED' },
        { product: 'mngd · Enterprise',  price: 'from $9/dev/mo', sub: 'Contact sales',                  color: 'rgba(255,255,255,0.2)' },
        { product: 'mngd patch',         price: 'Free',         sub: '1–25 devices, forever',            color: '#0F6E56' },
        { product: 'mngd patch',         price: '$49/mo',       sub: '26–50 devices flat',               color: '#0F6E56' },
      ].map(row => (
        <div style="background:#0a0a0a; padding:14px 20px; display:flex; align-items:center; justify-content:space-between; gap:16px;">
          <div style="display:flex; align-items:center; gap:8px;">
            <span style={`width:6px; height:6px; border-radius:50%; background:${row.color}; flex-shrink:0;`}></span>
            <span style="font-size:13px; color:rgba(255,255,255,0.6);">{row.product}</span>
            <span style="font-size:12px; color:rgba(255,255,255,0.3);">— {row.sub}</span>
          </div>
          <span style="font-family:'JetBrains Mono',monospace; font-size:13px; font-weight:500; color:#fff; white-space:nowrap;">{row.price}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<hr class="divider" />

<!-- ── Bottom CTA ─────────────────────────────────────────────────────────── -->
<section style="max-width:1080px; margin:0 auto; padding:80px 32px 96px;">
  <div class="cta-band">
    <h2 style="font-size:clamp(28px,4vw,48px); font-weight:600; letter-spacing:-0.04em; line-height:1.1; margin-bottom:16px;">
      Ready to enroll your first device?
    </h2>
    <p style="font-size:16px; color:rgba(255,255,255,0.5); margin-bottom:36px; max-width:440px; margin-left:auto; margin-right:auto; line-height:1.65;">
      Sign up and enroll your first device in minutes.
    </p>
    <div style="display:flex; align-items:center; justify-content:center; gap:12px; flex-wrap:wrap;">
      <a href="https://app.mngd.app/register" class="mngd-btn-primary">
        Create an account
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 11L11 3M6 3h5v5"/></svg>
      </a>
      <a href="https://docs.mngd.app/getting-started" class="mngd-btn-secondary">Read the docs</a>
    </div>
  </div>
</section>

</Layout>
