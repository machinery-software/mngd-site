---
import Layout from '../layouts/Layout.astro';
import CircuitHero from '../components/CircuitHero.astro';
---

<Layout
  title="mngd — patch management for Mac, MDM coming soon"
  description="mngd patch is shipping today: agent-based patch management, CVE tracking, AI tool governance. Free up to 25 devices. Full Apple MDM (DDM, SCEP, ABM) on the roadmap — join the waitlist."
>

<style>
  body { background: #000 !important; }

  .feature-grid {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 1px; background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 12px; overflow: hidden;
  }
  .feature-card {
    background: #0a0a0a; padding: 32px 28px;
    display: flex; flex-direction: column; gap: 12px;
  }
  .feature-icon {
    font-family: 'JetBrains Mono', monospace;
    font-size: 18px; color: #6B82F0; line-height: 1;
  }
  .feature-card h3 {
    font-size: 15px; font-weight: 600;
    letter-spacing: -0.01em; line-height: 1.3;
  }
  .feature-card p {
    font-size: 13px; color: rgba(255,255,255,0.45);
    line-height: 1.65;
  }
  .feature-card.coming { opacity: 0.85; }
  .feature-card.coming .feature-icon { color: rgba(255,255,255,0.32); }
  .feature-status {
    display: inline-flex; align-items: center; gap: 6px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px; letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 2px 8px; border-radius: 4px;
    width: fit-content;
  }
  .feature-status.live {
    color: #3BB98C;
    background: rgba(15,110,86,0.15);
    border: 1px solid rgba(15,110,86,0.3);
  }
  .feature-status.soon {
    color: rgba(255,255,255,0.45);
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.1);
  }
  .feature-status.live::before {
    content: ''; width: 5px; height: 5px;
    border-radius: 50%; background: #3BB98C;
  }
  .feature-waitlist-link {
    font-size: 12px; color: rgba(107,130,240,0.85);
    text-decoration: underline; text-underline-offset: 3px;
    margin-top: 4px;
  }
  .feature-waitlist-link:hover { color: #6B82F0; }
  .group-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px; letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.4);
    margin-bottom: 16px;
  }

  .step-grid {
    display: grid; grid-template-columns: repeat(4, 1fr);
    gap: 1px; background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 12px; overflow: hidden;
  }
  .step-card {
    background: #0a0a0a; padding: 28px 24px;
  }
  .step-num {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px; color: rgba(255,255,255,0.2);
    margin-bottom: 16px;
  }
  .step-card h3 { font-size: 14px; font-weight: 600; letter-spacing: -0.01em; margin-bottom: 8px; }
  .step-card p  { font-size: 13px; color: rgba(255,255,255,0.45); line-height: 1.6; }

  .cta-band {
    background: #0a0a0a;
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 12px;
    padding: 64px 48px;
    text-align: center;
  }

  @media (max-width: 860px) {
    .feature-grid { grid-template-columns: 1fr; }
    .step-grid    { grid-template-columns: 1fr 1fr; }
    .cta-band     { padding: 40px 24px; }
  }
  @media (max-width: 540px) {
    .step-grid { grid-template-columns: 1fr; }
  }
</style>

<!-- ── Hero ──────────────────────────────────────────────────────────────── -->
<CircuitHero>
  <div style="max-width:1080px; margin:0 auto; padding:112px 32px 96px; text-align:center;">

    <div style="display:inline-flex; align-items:center; gap:8px; font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:0.06em; color:rgba(255,255,255,0.4); background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.08); padding:5px 14px; border-radius:99px; margin-bottom:32px; text-transform:uppercase;">
      mngd patch · shipping today
    </div>

    <h1 style="font-size:clamp(40px,6vw,72px); font-weight:600; letter-spacing:-0.04em; line-height:1.05; max-width:800px; margin:0 auto 24px;">
      Patch management that<br>
      <span style="color:rgba(255,255,255,0.45);">stays out of your way.</span>
    </h1>

    <p style="font-size:18px; font-weight:300; color:rgba(255,255,255,0.5); max-width:520px; margin:0 auto 40px; line-height:1.65; letter-spacing:-0.01em;">
      mngd patch keeps every Mac patched. Lightweight agent, CVE tracking, AI tool governance.
      Full Apple MDM — DDM, SCEP, ABM — is coming next.
    </p>

    <div style="display:flex; align-items:center; justify-content:center; gap:16px; flex-wrap:wrap; margin-bottom:20px;">
      <a href="https://app.mngd.app/register" class="mngd-btn-primary">
        Start free with mngd patch
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 11L11 3M6 3h5v5"/></svg>
      </a>
      <a href="/early-access" class="mngd-btn-secondary">Join MDM waitlist</a>
    </div>
    <p style="font-size:13px; color:rgba(255,255,255,0.3);">
      <a href="/patch" style="color:rgba(255,255,255,0.5); text-decoration:underline; text-underline-offset:3px;">mngd patch</a> is free up to 25 devices, no card. Full MDM tier in early access — <a href="/early-access" style="color:rgba(255,255,255,0.5); text-decoration:underline; text-underline-offset:3px;">join the waitlist</a>.
    </p>

  </div>
</CircuitHero>

<hr class="divider" />

<!-- ── Social proof strip ─────────────────────────────────────────────────── -->
<div style="max-width:1080px; margin:0 auto; padding:28px 32px; display:flex; align-items:center; justify-content:center; gap:40px; flex-wrap:wrap;">
  {[
    '3,000+ apps covered',
    'CVE-driven priority',
    'Installomator-based',
    'AI tool governance',
    'Slack alerts',
    'macOS — Mac-first',
  ].map(item => (
    <span style="font-size:12px; color:rgba(255,255,255,0.28); font-weight:500; letter-spacing:0.02em;">{item}</span>
  ))}
</div>

<hr class="divider" />

<!-- ── Features ───────────────────────────────────────────────────────────── -->
<section id="features" style="max-width:1080px; margin:0 auto; padding:80px 32px;">
  <div class="mono-label" style="margin-bottom:40px;">Platform</div>
  <h2 style="font-size:clamp(28px,4vw,42px); font-weight:600; letter-spacing:-0.03em; line-height:1.15; margin-bottom:16px; max-width:680px;">
    Patch shipping today. <br><span style="color:rgba(255,255,255,0.45);">Full MDM is next.</span>
  </h2>
  <p style="font-size:15px; color:rgba(255,255,255,0.5); line-height:1.7; max-width:560px; margin-bottom:48px;">
    mngd patch is live and free up to 25 devices. The MDM tier — DDM, SCEP, ABM, profiles — is in active development. Join the <a href="/early-access" style="color:rgba(255,255,255,0.7); text-decoration:underline; text-underline-offset:3px;">waitlist</a> and we'll lock your launch rate.
  </p>

  <div class="group-label" style="color:#3BB98C;">
    <span style="display:inline-block; width:6px; height:6px; border-radius:50%; background:#3BB98C; margin-right:8px; vertical-align:middle;"></span>
    Available now · mngd patch
  </div>
  <div class="feature-grid" style="margin-bottom:48px;">
    {[
      { icon: '⊜', title: 'Patch detection & vulnerability scanning', body: 'Lightweight agent inventories every installed app and the OS. CVE scoring is applied server-side via OSV.dev so high-severity exposures float to the top.' },
      { icon: '⊕', title: 'Installomator-based patching', body: 'Silent install when an app is closed; nudge users when it\'s open. 3,000+ third-party apps covered out of the box, no per-app scripting required.' },
      { icon: '◈', title: 'AI tool detection (MCP)', body: 'Phase 1, 2, and 3 shipped. Detect Model Context Protocol servers and AI agents on every Mac. Fleet-wide visibility into Claude Desktop, Cursor, and other AI tooling.' },
      { icon: '⊛', title: 'AI tools console', body: 'Admin surface for governing AI tooling across your fleet. See which devices run which MCP servers, set alerts, and start enforcing policy.' },
      { icon: '⊞', title: 'Self-service & dev packages', body: 'Per-user dev packages for engineers; managed self-service catalog for everyone else. Install on demand without bothering IT.' },
      { icon: '⊟', title: 'Slack alerts on vulnerabilities', body: 'Get notified when a high-severity CVE lands in your fleet, when a patch fails, or when a Mac falls behind your compliance threshold. Slack and email today.' },
    ].map(f => (
      <div class="feature-card">
        <div class="feature-icon">{f.icon}</div>
        <span class="feature-status live">Available now</span>
        <h3>{f.title}</h3>
        <p>{f.body}</p>
      </div>
    ))}
  </div>

  <div class="group-label">
    <span style="display:inline-block; width:6px; height:6px; border-radius:50%; background:rgba(255,255,255,0.35); margin-right:8px; vertical-align:middle;"></span>
    Coming soon · mngd MDM tier
  </div>
  <div class="feature-grid">
    {[
      { icon: '◇', title: 'Declarative Device Management', body: 'DDM is Apple\'s replacement for the polling-based MDM protocol. mngd will speak DDM natively — declarations, not commands. In active development.' },
      { icon: '⬡', title: 'SCEP enrollment & ABM', body: 'Built-in SCEP CA for device identity certs. Apple Business Manager + zero-touch ADE enrollment. Coming with the MDM tier launch.' },
      { icon: '⊝', title: 'Profiles, SCIM & device commands', body: 'Configuration profile push, SCIM 2.0 user provisioning from Okta or Entra, lock/wipe/restart device commands, FileVault escrow, VPP app distribution.' },
    ].map(f => (
      <div class="feature-card coming">
        <div class="feature-icon">{f.icon}</div>
        <span class="feature-status soon">Coming soon</span>
        <h3>{f.title}</h3>
        <p>{f.body}</p>
        <a href="/early-access" class="feature-waitlist-link">Join the waitlist →</a>
      </div>
    ))}
  </div>
</section>

<hr class="divider" />

<!-- ── How it works ───────────────────────────────────────────────────────── -->
<section style="max-width:1080px; margin:0 auto; padding:80px 32px;">
  <div class="mono-label" style="margin-bottom:40px;">How mngd patch works</div>
  <h2 style="font-size:clamp(26px,3.5vw,38px); font-weight:600; letter-spacing:-0.03em; line-height:1.15; margin-bottom:48px;">
    From install to first patch in under two minutes.
  </h2>

  <div class="step-grid">
    {[
      { step: '01', title: 'Install the agent', body: 'One signed pkg. Deploy it however you already deploy software — Munki, Jamf, manual, MDM, whatever you have.' },
      { step: '02', title: 'Agent inventories the Mac', body: 'On first run, the agent reports every installed app, its version, and the OS. CVE scores are applied server-side.' },
      { step: '03', title: 'You set policy', body: 'Define patch windows, deferral rules, and notification preferences in the dashboard. No per-app scripting required.' },
      { step: '04', title: 'mngd patches and alerts', body: 'Silent install when an app is closed; nudge users when it\'s open. Slack alerts when a high-severity CVE lands.' },
    ].map(s => (
      <div class="step-card">
        <div class="step-num">{s.step}</div>
        <h3>{s.title}</h3>
        <p>{s.body}</p>
      </div>
    ))}
  </div>
</section>

<hr class="divider" />

<!-- ── Pricing teaser ─────────────────────────────────────────────────────── -->
<section style="max-width:1080px; margin:0 auto; padding:80px 32px;">
  <div style="display:grid; grid-template-columns:1fr 1fr; gap:48px; align-items:center;">
    <div>
      <div class="mono-label" style="margin-bottom:24px;">Pricing</div>
      <h2 style="font-size:clamp(26px,3.5vw,38px); font-weight:600; letter-spacing:-0.03em; line-height:1.15; margin-bottom:16px;">
        Simple, honest pricing.
      </h2>
      <p style="font-size:15px; color:rgba(255,255,255,0.5); line-height:1.7; margin-bottom:32px;">
        mngd patch is live — free up to 25 devices, $49/mo flat for 26–50. Full MDM-tier pricing is locked in for waitlist members at $6/device/month for 24 months.
      </p>
      <div style="display:flex; align-items:center; gap:12px; flex-wrap:wrap;">
        <a href="https://app.mngd.app/register" class="mngd-btn-primary">Start free with mngd patch</a>
        <a href="/pricing" class="mngd-btn-secondary">See all pricing</a>
      </div>
    </div>
    <div style="display:flex; flex-direction:column; gap:1px; background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.06); border-radius:12px; overflow:hidden;">
      {[
        { product: 'mngd patch',         price: 'Free',         sub: '1–25 devices, forever',            color: '#0F6E56', status: 'live' },
        { product: 'mngd patch',         price: '$49/mo',       sub: '26–50 devices flat',               color: '#0F6E56', status: 'live' },
        { product: 'mngd patch · MSP',   price: '$49 + $1.25/dev', sub: '51+ devices, multi-tenant',     color: '#0F6E56', status: 'live' },
        { product: 'mngd · Standard',    price: '$6/dev/mo',    sub: 'Full MDM — waitlist',              color: '#2D3A9E', status: 'soon' },
        { product: 'mngd · MSP',         price: '$4.50/dev/mo', sub: 'Full MDM — waitlist',              color: '#7C3AED', status: 'soon' },
      ].map(row => (
        <div style="background:#0a0a0a; padding:14px 20px; display:flex; align-items:center; justify-content:space-between; gap:16px;">
          <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
            <span style={`width:6px; height:6px; border-radius:50%; background:${row.color}; flex-shrink:0;`}></span>
            <span style="font-size:13px; color:rgba(255,255,255,0.6);">{row.product}</span>
            <span style="font-size:12px; color:rgba(255,255,255,0.3);">— {row.sub}</span>
          </div>
          <span style="font-family:'JetBrains Mono',monospace; font-size:13px; font-weight:500; color:#fff; white-space:nowrap;">{row.price}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<hr class="divider" />

<!-- ── Bottom CTA ─────────────────────────────────────────────────────────── -->
<section style="max-width:1080px; margin:0 auto; padding:80px 32px 96px;">
  <div class="cta-band">
    <h2 style="font-size:clamp(28px,4vw,48px); font-weight:600; letter-spacing:-0.04em; line-height:1.1; margin-bottom:16px;">
      Start with patch. Add MDM when it ships.
    </h2>
    <p style="font-size:16px; color:rgba(255,255,255,0.5); margin-bottom:36px; max-width:480px; margin-left:auto; margin-right:auto; line-height:1.65;">
      mngd patch is free up to 25 devices today. The MDM tier is in active development — join the waitlist and we'll lock your launch rate.
    </p>
    <div style="display:flex; align-items:center; justify-content:center; gap:12px; flex-wrap:wrap;">
      <a href="https://app.mngd.app/register" class="mngd-btn-primary">
        Start free with mngd patch
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 11L11 3M6 3h5v5"/></svg>
      </a>
      <a href="/early-access" class="mngd-btn-secondary">Join MDM waitlist</a>
    </div>
  </div>
</section>

</Layout>
