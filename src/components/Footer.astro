---
import Brand from './Brand.astro';

/**
 * Preline's footer block, restyled. The large wordmark at the bottom is the
 * site's one piece of pure decoration, and it earns its place by being the only
 * one: it sits behind a soft accent bloom, clipped so it never introduces a
 * horizontal scrollbar at phone width.
 *
 * The "Built on" link is not optional decoration — CLAIMS.md requires the credits
 * section to be reachable from the footer of every page.
 */
const year = new Date().getFullYear();

const columns = [
  {
    title: 'Site',
    links: [
      { href: '/', label: 'Home' },
      { href: '/blog', label: 'Field Notes' },
      { href: '/about', label: 'About' },
      { href: '/early-access', label: 'Join the waitlist' },
    ],
  },
  {
    title: 'Honesty',
    links: [
      { href: '/credits', label: 'Built on' },
      { href: '/claims', label: 'Claims charter' },
      { href: '/privacy', label: 'Privacy' },
      { href: '/terms', label: 'Terms' },
    ],
  },
];
---

<footer class="relative mt-24 overflow-hidden border-t border-line bg-footer">
  <div class="mx-auto max-w-(--container-wide) px-(--gutter) pt-14 max-sm:px-5">
    <div class="grid gap-10 sm:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <div class="flex items-center gap-2.5">
          <Brand size={24} />
          <span class="font-mono text-[14px] font-medium tracking-tight text-ink">mngd</span>
        </div>
        <p class="mt-3 max-w-[38ch] text-[13.5px] leading-relaxed text-muted">
          Apple device management with the fleet repository inside the product.
          Built by Machinery&nbsp;Software&nbsp;LLC in Michigan.
        </p>
        <a
          href="mailto:hello@mngd.app"
          class="mt-3 inline-block font-mono text-[12.5px] text-accent no-underline hover:underline"
        >
          hello@mngd.app
        </a>
      </div>

      {columns.map(col => (
        <div>
          <div class="font-mono text-[11px] tracking-[0.08em] text-faint uppercase">{col.title}</div>
          <ul class="mt-3 space-y-2">
            {col.links.map(l => (
              <li>
                <a
                  href={l.href}
                  class="text-[13.5px] text-muted no-underline underline-offset-4 hover:text-ink hover:underline"
                >
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-12 flex flex-wrap items-center justify-between gap-3 border-t border-line py-5">
      <p class="font-mono text-[11.5px] text-faint">
        &copy; {year} Machinery Software LLC
      </p>
      <p class="font-mono text-[11.5px] text-faint">
        mngd.app
      </p>
    </div>
  </div>

  <!-- The wordmark. aria-hidden because it repeats the brand already read out
       above, and pointer-events-none so it never eats a click near the bottom
       of the page. -->
  <div class="pointer-events-none relative select-none" aria-hidden="true">
    <div class="footer-bloom"></div>
    <div class="footer-wordmark">mngd</div>
  </div>
</footer>

<style>
  .footer-wordmark {
    font-family: var(--mono);
    font-weight: 500;
    font-size: clamp(72px, 22vw, 260px);
    line-height: 0.78;
    letter-spacing: -0.05em;
    text-align: center;
    color: transparent;
    background: linear-gradient(to bottom, var(--faint-line) 0%, transparent 88%);
    -webkit-background-clip: text;
    background-clip: text;
    /* Cropped at the baseline so the glyphs sink into the page edge rather than
       sitting on it. */
    margin-bottom: -0.16em;
    padding-top: 0.08em;
  }

  .footer-bloom {
    position: absolute;
    left: 50%;
    bottom: -40%;
    width: min(760px, 130%);
    height: 300px;
    transform: translateX(-50%);
    background: radial-gradient(ellipse at center, var(--accent-soft) 0%, transparent 68%);
    opacity: 0.75;
  }
</style>
