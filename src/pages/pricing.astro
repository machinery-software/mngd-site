---
import Layout from '../layouts/Layout.astro';
import CircuitHero from '../components/CircuitHero.astro';
---

<Layout
  title="Pricing — mngd"
  description="Launch pricing: $6/device/month. Full Apple MDM, patch management, compliance, CVE tracking, MCP server scanning — all bundled, no feature gating. mngd patch free up to 25 devices."
  canonical="https://mngd.app/pricing"
>

  <!-- ── Hero with circuit backdrop ─────────────────────────────────────── -->
  <CircuitHero>
    <div class="max-w-6xl mx-auto px-6 pt-28 pb-16 text-center">
      <div class="label mb-4">Pricing</div>
      <h1 class="text-4xl md:text-5xl font-semibold text-white tracking-tight mb-4">
        Mac management, done right.
      </h1>
      <p class="text-white/55 max-w-xl mx-auto">
        Launch pricing: $6/device/month. All features included — no gating, no add-ons.
      </p>
      <div class="inline-flex items-center gap-2 mt-6 px-3 py-1.5 rounded-full bg-white/[0.04] border border-white/[0.08] text-xs text-white/60">
        <span class="w-1.5 h-1.5 rounded-full" style="background:#F59E0B;"></span>
        Launch pricing — locked in for 24 months at your signup rate.
      </div>
    </div>
  </CircuitHero>

  <section class="section pt-0">
    <div class="container">

      <!-- ── Pricing cards ──────────────────────────────────────────────── -->
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4 mb-20">

        <!-- mngd patch (standalone, free entry) -->
        <div class="price-card">
          <div class="price-card-body">
            <div>
              <div class="inline-flex px-2 py-0.5 rounded text-[11px] font-semibold mb-3" style="background:rgba(15,110,86,0.18); color:#3BB98C;">mngd patch</div>
              <p class="text-xs text-white/45">Patch management, standalone.</p>
            </div>
            <div>
              <div class="flex items-end gap-1 mb-1">
                <span class="text-4xl font-semibold text-white">Free</span>
              </div>
              <p class="text-xs text-white/40">1–25 devices, forever. No card.</p>
              <div class="mt-3 space-y-1">
                <div class="flex justify-between text-xs gap-2">
                  <span class="text-white/45">26–50</span>
                  <span class="text-white/55">$49/mo flat</span>
                </div>
                <div class="flex justify-between text-xs gap-2">
                  <span class="text-white/45">51+</span>
                  <span class="text-white/55">$49 + $1.25/device</span>
                </div>
                <div class="flex justify-between text-xs gap-2">
                  <span class="text-white/45">Annual</span>
                  <span class="text-white/55">17% off</span>
                </div>
              </div>
            </div>
          </div>
          <a href="https://app.mngd.app/register" class="price-card-cta" style="background:#0F6E56;">
            Start free
          </a>
        </div>

        <!-- Standard (featured) -->
        <div class="price-card border-white/[0.12] ring-1 ring-inset ring-white/[0.06]" style="background:rgba(45,58,158,0.08);">
          <div class="price-card-body">
            <div>
              <div class="inline-flex px-2 py-0.5 rounded text-[11px] font-semibold mb-3" style="background:rgba(45,58,158,0.2); color:#6B82F0;">Standard</div>
              <p class="text-xs text-white/45">Full platform. Launch pricing.</p>
            </div>
            <div>
              <div class="flex items-end gap-1 mb-1">
                <span class="text-4xl font-semibold text-white">$6</span>
                <span class="text-sm text-white/45 mb-1">/device/month</span>
              </div>
              <p class="text-xs text-white/40">Annual billing · 10-device minimum</p>
              <div class="mt-3 space-y-1">
                <div class="flex justify-between text-xs gap-2">
                  <span class="text-white/45">Monthly</span>
                  <span class="text-white/55">$7.25/device/month</span>
                </div>
                <div class="flex justify-between text-xs gap-2">
                  <span class="text-white/45">mngd patch</span>
                  <span class="text-white/55">Bundled</span>
                </div>
              </div>
            </div>
          </div>
          <a href="/early-access" class="price-card-cta" style="background:#2D3A9E;">
            Join the waitlist
          </a>
        </div>

        <!-- MSP -->
        <div class="price-card">
          <div class="price-card-body">
            <div>
              <div class="inline-flex px-2 py-0.5 rounded text-[11px] font-semibold mb-3" style="background:rgba(124,58,237,0.18); color:#A78BFA;">For MSPs</div>
              <p class="text-xs text-white/45">Mac fleets across clients.</p>
            </div>
            <div>
              <div class="flex items-end gap-1 mb-1">
                <span class="text-4xl font-semibold text-white">$4.50</span>
                <span class="text-sm text-white/45 mb-1">/device/month</span>
              </div>
              <p class="text-xs text-white/40">Annual · $150/mo account min</p>
              <div class="mt-3 space-y-1">
                <div class="flex justify-between text-xs gap-2">
                  <span class="text-white/45">Monthly</span>
                  <span class="text-white/55">$5.40/device/month</span>
                </div>
                <div class="flex justify-between text-xs gap-2">
                  <span class="text-white/45">Multi-tenant</span>
                  <span class="text-white/55">Included</span>
                </div>
              </div>
            </div>
          </div>
          <a href="/early-access" class="price-card-cta border border-white/10 hover:border-white/20" style="background:transparent;">
            Join the MSP waitlist
          </a>
        </div>

        <!-- Enterprise -->
        <div class="price-card">
          <div class="price-card-body">
            <div>
              <div class="inline-flex px-2 py-0.5 rounded text-[11px] font-semibold mb-3 bg-white/5 text-white/55">Enterprise</div>
              <p class="text-xs text-white/45">Large fleets, compliance, custom terms.</p>
            </div>
            <div>
              <div class="flex items-baseline gap-1 mb-1">
                <span class="text-xs text-white/45">Starting</span>
                <span class="text-4xl font-semibold text-white">$9</span>
                <span class="text-sm text-white/45">/device/month</span>
              </div>
              <p class="text-xs text-white/40">Contact sales for custom terms</p>
            </div>
          </div>
          <a href="mailto:hello@mngd.app" class="price-card-cta border border-white/10 hover:border-white/20 text-white/70 hover:text-white" style="background:transparent;">
            Contact sales
          </a>
        </div>

      </div>

      <!-- ── What's included ────────────────────────────────────────────── -->
      <div class="max-w-3xl mx-auto mb-20">
        <h2 class="text-xl font-semibold text-white tracking-tight mb-2 text-center">What's included — in every tier</h2>
        <p class="text-xs text-white/40 text-center mb-6">No feature gating. One platform, one feature set, every plan.</p>
        <div class="card p-6">
          <ul class="grid md:grid-cols-2 gap-x-6 gap-y-3">
            {[
              'Full Mac MDM (macOS and iOS/iPadOS)',
              'Declarative Device Management (DDM)',
              'osquery-backed compliance checks',
              'mSCP baselines',
              'CVE tracking with live intelligence',
              'Package inventory (Homebrew, npm, pip)',
              'MCP server scanning (AI tool governance)',
              'Rules engine with Slack / PagerDuty / email / webhook',
              'SAML, OIDC, SCIM',
              'Apple Business Manager + ADE',
              'mngd patch fully bundled',
              'All future platform features',
            ].map(f => (
              <li class="flex items-start gap-2 text-sm text-white/65">
                <svg class="w-4 h-4 mt-0.5 shrink-0 text-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
                {f}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- ── Honest scope ───────────────────────────────────────────────── -->
      <div class="max-w-3xl mx-auto mb-20">
        <h2 class="text-xl font-semibold text-white tracking-tight mb-6 text-center">What mngd does not include today</h2>
        <div class="card p-6 space-y-5">
          {[
            { k: 'EDR',                 v: 'Integrate with your existing endpoint detection. We ship MDM, not endpoint security.' },
            { k: 'Identity / ZTNA',     v: 'Shipping later as mngd Network. Continue using Okta, Entra, or Google for now.' },
            { k: 'Cross-platform UEM',  v: 'macOS and iOS/iPadOS only. No Android, no Windows.' },
          ].map(row => (
            <div class="flex flex-col sm:flex-row sm:gap-4">
              <div class="w-40 shrink-0 text-sm text-white font-medium mb-1 sm:mb-0">{row.k}</div>
              <div class="text-sm text-white/55 leading-relaxed">{row.v}</div>
            </div>
          ))}
        </div>
      </div>

      <!-- ── mngd patch standalone (detail) ─────────────────────────────── -->
      <div class="max-w-3xl mx-auto mb-20" id="patch">
        <div class="text-center mb-8">
          <div class="label mb-3" style="color:#0F6E56;">mngd patch · pricing detail</div>
          <h2 class="text-2xl font-semibold text-white tracking-tight mb-3">Full mngd patch pricing</h2>
          <p class="text-sm text-white/55 max-w-xl mx-auto">
            App and OS patching as a standalone product. No MDM required.
            <span class="text-white/35">Formerly Patchable.</span>
          </p>
        </div>

        <div class="card overflow-hidden mb-6">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-white/[0.06]">
                <th class="text-left px-5 py-3 text-xs font-medium text-white/40 uppercase tracking-wider">Devices</th>
                <th class="text-right px-5 py-3 text-xs font-medium text-white/40 uppercase tracking-wider">Monthly</th>
                <th class="text-right px-5 py-3 text-xs font-medium text-white/40 uppercase tracking-wider">Annual (17% off)</th>
              </tr>
            </thead>
            <tbody>
              {[
                { range: '1–25',  monthly: '$0',                                    annual: '$0 · free forever' },
                { range: '26–50', monthly: '$49 flat',                               annual: '$489 / year' },
                { range: '51+',   monthly: '$49 + $1.25 per device above 50',       annual: '$489 + $12.45 per device above 50' },
              ].map((row, i) => (
                <tr class={i < 2 ? 'border-b border-white/[0.04]' : ''}>
                  <td class="px-5 py-3 text-white/70">{row.range}</td>
                  <td class="px-5 py-3 text-right text-white font-medium">{row.monthly}</td>
                  <td class="px-5 py-3 text-right text-white/55">{row.annual}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="mb-6">
          <h3 class="text-xs font-semibold text-white/40 uppercase tracking-wider mb-3 text-center">Worked examples · monthly billing</h3>
          <div class="grid grid-cols-2 md:grid-cols-3 gap-2">
            {[
              { n: '25',  p: '$0'       },
              { n: '50',  p: '$49'      },
              { n: '75',  p: '$80.25'   },
              { n: '100', p: '$111.50'  },
              { n: '250', p: '$299'     },
              { n: '500', p: '$611.50'  },
            ].map(e => (
              <div class="card px-4 py-3 flex justify-between text-sm">
                <span class="text-white/50">{e.n} devices</span>
                <span class="text-white font-medium">{e.p}/mo</span>
              </div>
            ))}
          </div>
        </div>

        <div class="text-center">
          <a href="https://app.mngd.app/register" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg text-white text-sm font-medium transition-colors" style="background:#0F6E56;">
            Start free with mngd patch
          </a>
        </div>
      </div>

      <!-- ── FAQ ────────────────────────────────────────────────────────── -->
      <div class="max-w-2xl mx-auto mb-20">
        <h2 class="text-2xl font-semibold text-white tracking-tight mb-8 text-center">Common questions</h2>
        <div class="space-y-4">
          {[
            { q: "What's bundled in mngd?",
              a: "Everything. MDM, DDM, patch management, compliance checks, CVE tracking, MCP scanning, notifications, identity integration — one price, no feature gates." },
            { q: "Why is launch pricing lower than the eventual price?",
              a: "We're launching with MDM, patch, and AI-assisted management. Identity/ZTNA and additional capabilities are on the roadmap. When those ship, pricing will reflect the expanded platform. Customers who sign up at launch pricing lock their rate for 24 months." },
            { q: "How does the MSP tier work?",
              a: "If you manage Mac fleets across multiple client organizations, you qualify for the MSP tier at $4.50/device/month. Includes multi-tenant admin, consolidated billing across your clients, and deal registration. $150/month account minimum." },
            { q: "Is there a free trial?",
              a: "mngd patch has a permanent free tier — up to 25 devices, all features, no credit card. The mngd full platform has a 14-day free trial, no credit card required." },
            { q: "What happens if my fleet grows mid-cycle?",
              a: "Monthly billing auto-adjusts at the next cycle. Annual billing has a 10% grace period — if you exceed your licensed count by more than 10%, we'll work with you to true-up at renewal. No surprise mid-year invoices." },
            { q: "Do you do EDR / endpoint detection?",
              a: "Not today. mngd is Mac MDM + patch + compliance + CVE + AI-assisted management. We integrate with your existing EDR stack. If you need EDR bundled with MDM, check Jamf Protect or Mosyle's bundled options." },
            { q: "Can I cancel?",
              a: "Yes, anytime. Monthly subscriptions end at the current billing cycle. Annual subscriptions run to their paid-through date. No long-term lock-in." },
            { q: "Is mngd patch really free forever for up to 25 devices?",
              a: "Yes. No credit card, no time limit. We want MacAdmins with small fleets to use mngd patch and tell their peers. When your fleet grows past 25, you start paying — but the first 25 always stay free within your pricing." },
          ].map(faq => (
            <details class="card p-5 group">
              <summary class="text-[15px] font-medium text-white cursor-pointer list-none flex items-center justify-between gap-4">
                {faq.q}
                <svg class="w-4 h-4 text-white/30 shrink-0 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </summary>
              <p class="mt-3 text-sm text-white/55 leading-relaxed">{faq.a}</p>
            </details>
          ))}
        </div>
      </div>

      <!-- ── Waitlist CTA ───────────────────────────────────────────────── -->
      <div class="max-w-2xl mx-auto text-center">
        <div class="card p-10">
          <h2 class="text-2xl font-semibold text-white tracking-tight mb-3">Lock in launch pricing.</h2>
          <p class="text-sm text-white/55 max-w-md mx-auto mb-6">
            The $6/device/month rate is available to early-access customers only — and stays locked for 24 months.
          </p>
          <div class="flex items-center justify-center gap-3 flex-wrap">
            <a href="/early-access" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg text-white text-sm font-medium transition-colors" style="background:#2D3A9E;">
              Join the waitlist
            </a>
            <a href="https://app.mngd.app/register" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg border border-white/10 hover:border-white/20 text-white/70 hover:text-white text-sm font-medium transition-colors">
              Start free with mngd patch
            </a>
          </div>
        </div>
      </div>

    </div>
  </section>

</Layout>
