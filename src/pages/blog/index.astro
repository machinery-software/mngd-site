---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

/**
 * Field Notes index — Preline's blog-list block, restyled.
 *
 * The empty state is the honest one: it says there is nothing published yet and
 * what the first one will be about, without a date attached to it. It does not
 * show placeholder cards, "coming soon" rows, or a fake post count.
 */
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

// UTC, deliberately: a frontmatter date of 2026-09-11 is UTC midnight, and
// formatting it in the build machine's timezone prints the 10th west of
// Greenwich. The date a note carries should not depend on where it was built.
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<Layout
  title="Field Notes — mngd"
  description="What ran, what refused, and what the device said — with the evidence ID attached."
>
  <section class="mx-auto max-w-(--container-wide) px-(--gutter) pt-16 pb-10 max-sm:px-5">
    <div class="max-w-[68ch]">
      <div class="eyebrow mb-6">Field Notes</div>
      <h1 class="text-[clamp(30px,5vw,44px)] text-ink">What ran, and what it said</h1>
      <p class="mt-5 text-[16.5px] leading-relaxed text-muted">
        Build notes from a one-person company, written after the fact rather than
        before it. Every technical claim in one of these carries the ID of the
        evidence entry it came from, and a note that records a failure is worth as
        much as one that records a success.
      </p>
    </div>

    {posts.length === 0 ? (
      <div class="mt-12 max-w-[68ch] rounded-xl border border-dashed border-faint-line bg-surface p-8">
        <div class="font-mono text-[11px] tracking-[0.08em] text-faint uppercase">
          Nothing published yet
        </div>
        <p class="mt-3 text-[15px] leading-relaxed text-muted">
          Field Note 001 is written and waiting on its four screenshots, which are
          captured from the mini after the console redress lands. It is about a
          MacBook Air installing Google Chrome because a declaration told it to — and
          naming the declaration in its own report.
        </p>
        <p class="mt-3 text-[15px] leading-relaxed text-muted">
          There is no publication date, because setting one would be the first claim
          on this site that nothing backs.
        </p>
        <a
          href="/early-access"
          class="mt-6 inline-flex items-center gap-2 rounded-lg border border-line px-4 py-2 text-[14px] font-medium text-ink no-underline transition-colors hover:bg-hover"
        >
          Get it by email instead
        </a>
      </div>
    ) : (
      <ul class="mt-12 divide-y divide-rowline overflow-hidden rounded-xl border border-line bg-surface">
        {posts.map(post => (
          <li>
            <a href={`/blog/${post.id}/`} class="group block p-6 no-underline transition-colors hover:bg-hover">
              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                {post.data.number !== undefined && (
                  <span class="font-mono text-[11px] tracking-[0.08em] text-faint uppercase">
                    Field Note {String(post.data.number).padStart(3, '0')}
                  </span>
                )}
                <time datetime={post.data.date.toISOString()} class="font-mono text-[11px] text-faint">
                  {fmt(post.data.date)}
                </time>
              </div>
              <h2 class="mt-2 text-[19px] text-ink group-hover:underline group-hover:underline-offset-4">
                {post.data.title}
              </h2>
              <p class="mt-2 max-w-[70ch] text-[14.5px] leading-relaxed text-muted">
                {post.data.description}
              </p>
              {post.data.evidence.length > 0 && (
                <div class="receipt-cite mt-3">{post.data.evidence.join(' · ')}</div>
              )}
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</Layout>
