---
interface Props {
  productColor?: string;   // background color of the logo badge
  productName?: string;    // product name shown next to the mark (defaults to 'mngd')
}

const {
  productColor = '#2D3A9E',
  productName  = 'mngd',
} = Astro.props;

const links = [
  { label: 'Features', href: '/#features' },
  { label: 'Pricing',  href: '/pricing' },
  { label: 'Docs',     href: 'https://docs.mngd.app' },
  { label: 'Blog',     href: '/blog' },
];
---

<header class="fixed top-0 inset-x-0 z-50 border-b border-white/[0.05] bg-black/80 backdrop-blur-xl">
  <div class="max-w-6xl mx-auto px-6 h-14 grid grid-cols-[1fr_auto_1fr] items-center gap-4">

    <!-- Logo mark + wordmark — left -->
    <a href="/" class="flex items-center gap-2.5 group" aria-label={`${productName} home`}>
      <!-- Colored badge with white mark -->
      <span
        class="flex-shrink-0 w-7 h-7 rounded-[6px] flex items-center justify-center transition-opacity group-hover:opacity-90"
        style={`background-color: ${productColor};`}
      >
        <!-- Machinery Software gear/glasses mark — white, scaled to fit -->
