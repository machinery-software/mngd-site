---
const year = new Date().getFullYear();

const links = {
  Product: [
    { label: 'mngd patch', href: '/patch' },
    { label: 'Pricing',    href: '/pricing' },
    { label: 'For MSPs',   href: '/pricing' },
    { label: 'Changelog',  href: '/blog' },
  ],
  Docs: [
    { label: 'Getting started',  href: 'https://docs.mngd.app/getting-started' },
    { label: 'Enrollment',       href: 'https://docs.mngd.app/enrollment' },
    { label: 'API reference',    href: 'https://docs.mngd.app/api' },
    { label: 'Security',         href: 'https://docs.mngd.app/security' },
  ],
  Company: [
    { label: 'Machinery Software', href: 'https://machinery.software' },
    { label: 'Privacy',            href: '/privacy' },
    { label: 'Terms',              href: '/terms' },
  ],
};
---

<footer class="border-t border-white/[0.06] py-16 px-6">
  <div class="max-w-6xl mx-auto">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-10 mb-16">

      <!-- Brand -->
      <div class="col-span-2 md:col-span-1">
        <div class="text-white font-semibold text-[15px] tracking-tight mb-3">mngd</div>
        <p class="text-sm text-white/40 leading-relaxed max-w-xs">
          Apple MDM built for the DDM era.
        </p>
      </div>

      <!-- Link columns -->
      {Object.entries(links).map(([group, items]) => (
        <div>
          <div class="text-xs font-semibold text-white/30 uppercase tracking-widest mb-4">{group}</div>
          <ul class="space-y-2.5">
            {items.map(item => (
              <li>
                <a href={item.href} class="text-sm text-white/50 hover:text-white transition-colors">
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="border-t border-white/[0.06] pt-8">
      <p class="text-xs text-white/30">© {year} Machinery Software LLC. All rights reserved.</p>
    </div>
  </div>
</footer>
