        </svg>
      </span>
      <!-- Wordmark -->
      <span class="text-white font-semibold text-[15px] tracking-tight">{productName}</span>
    </a>

    <!-- Nav links — truly centered -->
    <nav class="hidden md:flex items-center gap-0.5">
      {links.map(l => (
        <a
          href={l.href}
          class="px-3.5 py-1.5 text-[13px] font-medium text-white/50 hover:text-white rounded-md transition-colors duration-150"
        >
          {l.label}
        </a>
      ))}
    </nav>

    <!-- Actions — right -->
    <div class="flex items-center justify-end gap-1">
      <a
        href="https://app.mngd.app/login"
        class="hidden md:inline-flex px-3.5 py-1.5 text-[13px] font-medium text-white/50 hover:text-white rounded-md transition-colors duration-150"
      >
        Sign in
      </a>
      <a
        href="https://app.mngd.app/register"
        class="inline-flex items-center px-3.5 py-1.5 rounded-md text-[13px] font-semibold transition-colors duration-150 text-white"
        style={`background-color: ${productColor};`}
      >
        Get started
      </a>
    </div>

  </div>
</header>

<div class="h-14"></div>
