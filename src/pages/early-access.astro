---
import Layout from '../layouts/Layout.astro';

/**
 * The waitlist. The form, its field names, its validation and its endpoint are
 * unchanged — the Worker at waitlist.mngd.app/submit already reads exactly these
 * keys, and the honeypot pair (client swallow + server 204) stays as built.
 *
 * What changed is the copy. The old page promised a launch rate of $6/device/month
 * locked for 24 months and a reply within 2 business days. CLAIMS.md forbids the
 * first (pricing for a product that is not shipping) and a one-person company
 * should not print the second. This page now promises a list and a Field Note,
 * which are the two things that actually exist.
 */
const WAITLIST_ENDPOINT = 'https://waitlist.mngd.app/submit';

const field =
  'rounded-lg border border-line bg-ground px-3 py-2.5 text-[14.5px] text-ink outline-none transition-colors placeholder:text-faint focus:border-accent';
const labelCls = 'font-mono text-[11px] tracking-[0.08em] text-faint uppercase';
---

<Layout
  title="Join the waitlist — mngd"
  description="Tell me about your fleet. The waitlist gets the Field Notes: what ran, what refused, and what the device said."
  canonical="https://mngd.app/early-access"
>
  <section class="mx-auto max-w-(--container-wide) px-(--gutter) pt-16 pb-10 max-sm:px-5">
    <div class="mx-auto max-w-[62ch]">
      <div class="eyebrow mb-6">Waitlist</div>
      <h1 class="text-[clamp(30px,5vw,44px)] text-ink">Join the waitlist</h1>
      <p class="mt-5 text-[16.5px] leading-relaxed text-muted">
        mngd is early and not generally available. There is no trial, no pricing page
        and no launch date — this list is how you hear what happened, and how I find
        out whose fleet is worth building for next.
      </p>
      <p class="mt-3 text-[14.5px] leading-relaxed text-faint">
        What you get: the Field Notes, with the evidence ID attached to every claim.
        I read every submission myself.
      </p>
    </div>

    <div class="mx-auto mt-10 max-w-[62ch]">
      <form id="waitlist-form" class="flex flex-col gap-5 rounded-xl border border-line bg-surface p-6 sm:p-8" novalidate>
        <div class="flex flex-col gap-2">
          <label for="name" class={labelCls}>Name</label>
          <input id="name" name="name" type="text" autocomplete="name" required maxlength="200" class={field} placeholder="Avery Chen" />
        </div>

        <div class="flex flex-col gap-2">
          <label for="email" class={labelCls}>Work email</label>
          <input id="email" name="email" type="email" autocomplete="email" required maxlength="200" class={field} placeholder="avery@company.com" />
        </div>

        <div class="flex flex-col gap-2">
          <label for="company" class={labelCls}>Company</label>
          <input id="company" name="company" type="text" autocomplete="organization" maxlength="200" class={field} placeholder="Acme MSP" />
        </div>

        <div class="flex flex-col gap-2">
          <label for="fleet_size" class={labelCls}>Fleet size</label>
          <select id="fleet_size" name="fleet_size" required class={field}>
            <option value="" disabled selected>Select a range</option>
            <option value="1–25">1–25 devices</option>
            <option value="26–100">26–100 devices</option>
            <option value="101–500">101–500 devices</option>
            <option value="501–2,000">501–2,000 devices</option>
            <option value="2,000+">2,000+ devices</option>
            <option value="MSP">MSP — multiple client orgs</option>
          </select>
        </div>

        <div class="flex flex-col gap-2">
          <label for="current_mdm" class={labelCls}>Current MDM</label>
          <input id="current_mdm" name="current_mdm" type="text" maxlength="100" class={field} placeholder="Jamf, Kandji, Intune, none, etc." />
          <p class="text-[12.5px] text-faint">What you're using today — or "none" if you're starting fresh.</p>
        </div>

        <div class="flex flex-col gap-2">
          <label for="use_case" class={labelCls}>What's broken about your current setup?</label>
          <textarea id="use_case" name="use_case" rows="4" maxlength="2000" class={`${field} resize-none`} placeholder="Polling delays, profile drift, MSP multi-tenancy, DDM gaps — whatever's pushing you to look."></textarea>
        </div>

        <!-- Honeypot — visually and assistive-tech hidden, real bots fill it. The
             Worker checks the same field server-side and answers 204, because a
             client-side check alone is theatre: bots POST to the Worker directly. -->
        <div aria-hidden="true" style="position:absolute; left:-9999px; width:1px; height:1px; overflow:hidden;">
          <label for="website_url">Website URL (leave blank)</label>
          <input id="website_url" name="website_url" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="flex flex-col gap-3 pt-1 sm:flex-row sm:items-center">
          <button
            type="submit"
            id="submit-btn"
            class="inline-flex items-center justify-center gap-2 rounded-lg bg-accent px-5 py-2.5 text-[15px] font-medium text-accent-contrast transition-colors hover:bg-accent-strong disabled:opacity-60"
          >
            <span id="submit-label">Join the waitlist</span>
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 11L11 3M6 3h5v5" /></svg>
          </button>
          <p class="text-[12.5px] text-faint">No tracking. I email you, and that's it.</p>
        </div>

        <div
          id="form-error"
          class="hidden rounded-lg border border-bad-line bg-bad-bg px-4 py-3 text-[14px] text-bad-ink"
          role="alert"
        ></div>
      </form>

      <div
        id="form-success"
        class="hidden rounded-xl border border-line bg-surface p-8 text-center"
        role="status"
        aria-live="polite"
      >
        <div class="text-[22px] font-semibold tracking-tight text-ink">You're on the list.</div>
        <p class="mx-auto mt-2 max-w-[44ch] text-[15px] leading-relaxed text-muted">
          Nothing else happens until there is something true to send you. The next
          thing you hear from me will be a Field Note.
        </p>
      </div>
    </div>
  </section>
</Layout>

<script is:inline define:vars={{ WAITLIST_ENDPOINT }}>
  (() => {
    const form = document.getElementById('waitlist-form');
    if (!form) return;

    const errorBox = document.getElementById('form-error');
    const successBox = document.getElementById('form-success');
    const submitBtn = document.getElementById('submit-btn');
    const submitLabel = document.getElementById('submit-label');
    const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    const MAILTO = 'mailto:david@machinery.software';

    function showError(msg, includeMailto) {
      errorBox.innerHTML = msg + (includeMailto
        ? ` Or email <a class="underline" href="${MAILTO}">david@machinery.software</a>.`
        : '');
      errorBox.classList.remove('hidden');
    }
    function clearError() {
      errorBox.classList.add('hidden');
      errorBox.textContent = '';
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearError();

      const fd = new FormData(form);

      // Honeypot — silently swallow.
      if ((fd.get('website_url') || '').toString().trim() !== '') {
        form.classList.add('hidden');
        successBox.classList.remove('hidden');
        return;
      }

      const name = (fd.get('name') || '').toString().trim();
      const email = (fd.get('email') || '').toString().trim();
      const company = (fd.get('company') || '').toString().trim();
      const fleet_size = (fd.get('fleet_size') || '').toString().trim();
      const current_mdm = (fd.get('current_mdm') || '').toString().trim();
      const use_case = (fd.get('use_case') || '').toString().trim();

      if (!name || !email || !fleet_size) {
        showError('Name, email, and fleet size are required.', false);
        return;
      }
      if (!EMAIL_RE.test(email)) {
        showError('That email address looks off — double-check it?', false);
        return;
      }

      submitBtn.disabled = true;
      submitLabel.textContent = 'Sending…';

      try {
        const res = await fetch(WAITLIST_ENDPOINT, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, email, company, fleet_size, current_mdm, use_case }),
        });

        if (res.ok) {
          form.classList.add('hidden');
          successBox.classList.remove('hidden');
          successBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
          return;
        }

        let detail = '';
        try { const j = await res.json(); detail = j.error || ''; } catch {}
        showError(
          detail
            ? `We couldn't record your submission: ${detail}.`
            : "We couldn't record your submission right now.",
          true,
        );
      } catch {
        showError("Network error — your submission didn't go through.", true);
      } finally {
        submitBtn.disabled = false;
        submitLabel.textContent = 'Join the waitlist';
      }
    });
  })();
</script>
