---
import Brand from './Brand.astro';
import ThemeControl from './ThemeControl.astro';

/**
 * Preline's navbar block, restyled onto the brand v2 tokens. The mobile
 * disclosure is Preline's `hs-collapse` — the one behaviour on this site that
 * needs its runtime.
 *
 * The nav lists only pages that exist and have something true on them. There is
 * no Docs, Pricing, Customers or Sign-in entry, because there is no honest page
 * behind any of those yet.
 */
const links = [
  { href: '/blog', label: 'Field Notes' },
  { href: '/credits', label: 'Built on' },
  { href: '/about', label: 'About' },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href || (href !== '/' && path.startsWith(href + '/'));
---

<header class="sticky top-0 z-40 border-b border-line bg-surface/85 backdrop-blur-md">
  <nav class="mx-auto flex max-w-(--container-wide) items-center justify-between gap-4 px-(--gutter) py-3 max-sm:px-5">
    <a href="/" class="flex items-center gap-2.5 no-underline" aria-label="mngd — home">
      <Brand size={26} />
      <span class="font-mono text-[15px] font-medium tracking-tight text-ink">mngd</span>
    </a>

    <div class="flex items-center gap-2">
      <ul class="hidden items-center gap-1 sm:flex">
        {links.map(l => (
          <li>
            <a
              href={l.href}
              aria-current={isCurrent(l.href) ? 'page' : undefined}
              class="rounded-md px-3 py-1.5 text-[14px] text-muted no-underline transition-colors hover:bg-hover hover:text-ink aria-[current=page]:text-ink aria-[current=page]:font-medium"
            >
              {l.label}
            </a>
          </li>
        ))}
      </ul>

      <ThemeControl />

      <a
        href="/early-access"
        class="hidden rounded-lg bg-accent px-3.5 py-2 text-[14px] font-medium text-accent-contrast no-underline transition-colors hover:bg-accent-strong sm:inline-flex"
      >
        Join the waitlist
      </a>

      <button
        type="button"
        class="hs-collapse-toggle inline-flex items-center justify-center rounded-lg border border-line bg-surface p-2 text-muted transition-colors hover:text-ink sm:hidden"
        id="nav-toggle"
        aria-expanded="false"
        aria-controls="nav-mobile"
        aria-label="Toggle navigation"
        data-hs-collapse="#nav-mobile"
      >
        <svg class="hs-collapse-open:hidden size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" /></svg>
        <svg class="hs-collapse-open:block hidden size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
      </button>
    </div>
  </nav>

  <div
    id="nav-mobile"
    class="hs-collapse hidden overflow-hidden transition-[height] duration-200 sm:hidden"
    aria-labelledby="nav-toggle"
  >
    <ul class="border-t border-line px-5 py-2">
      {links.map(l => (
        <li>
          <a
            href={l.href}
            aria-current={isCurrent(l.href) ? 'page' : undefined}
            class="block rounded-md px-1 py-2.5 text-[15px] text-muted no-underline aria-[current=page]:font-medium aria-[current=page]:text-ink"
          >
            {l.label}
          </a>
        </li>
      ))}
      <li class="pt-1 pb-3">
        <a
          href="/early-access"
          class="inline-flex rounded-lg bg-accent px-3.5 py-2 text-[14px] font-medium text-accent-contrast no-underline"
        >
          Join the waitlist
        </a>
      </li>
    </ul>
  </div>
</header>
